# ---------------------------------------------------------------
# Formulario de contacto
#
# Sin estas variables el sitio funciona, pero el formulario responde
# pidiendo que te escriban directamente al correo.
#
# Resend exige verificar un dominio propio para enviar: no se puede
# mandar desde una dirección cualquiera. Como bryanescobar.dev ya está
# en Vercel, los registros DNS se agregan en Vercel y Resend los
# verifica solo.
#
#   1. Cuenta en https://resend.com
#   2. Domains > Add Domain > bryanescobar.dev
#   3. Resend da unos registros (MX y TXT). Se copian en
#      Vercel > el proyecto > Domains > bryanescobar.dev > DNS Records
#   4. API Keys > Create API Key, y se pega abajo
#   5. En Vercel: Settings > Environment Variables, las tres variables
#   6. Redeploy, porque las variables se leen al construir
# ---------------------------------------------------------------

RESEND_API_KEY=

# Correo donde quieres recibir los mensajes del formulario.
# Si se omite, usa el email definido en config/site.ts
CONTACT_EMAIL_TO=

# Remitente. Tiene que ser del dominio verificado en Resend.
#
# No hace falta crear un buzón para esta dirección: solo se usa para
# enviar. Las respuestas van al correo de quien escribió, porque la
# acción manda su dirección en reply_to.
CONTACT_EMAIL_FROM="Portafolio <contacto@bryanescobar.dev>"
