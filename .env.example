# ---------------------------------------------------------------
# Formulario de contacto (opcional)
# Sin estas variables el sitio funciona, pero el formulario responde
# pidiendo que te escriban directamente al correo.
#
# 1. Crea una cuenta gratuita en https://resend.com
# 2. Genera una API key y pégala aquí
# 3. En Vercel: Project Settings > Environment Variables
# ---------------------------------------------------------------

RESEND_API_KEY=

# Correo donde quieres recibir los mensajes del formulario.
# Si se omite, usa el email definido en config/site.ts
CONTACT_EMAIL_TO=

# Remitente. Mientras no verifiques un dominio propio en Resend,
# deja el valor por defecto de pruebas:
CONTACT_EMAIL_FROM="Portafolio <onboarding@resend.dev>"
